            </attribute>
            <layout class="QVBoxLayout" name="eventsTabLayout">
              <item>
                <widget class="QLabel" name="eventsNote">
                  <property name="text">
                    <string>Zaman ölçüm aşamasından başlar. Tür: wind / link / sensor. Wind A=m/s, B=yön°. Link A=kayıp%, B=gecikme ms (panel↔PX4). Sensor A=0 gyro,1 accel,2 mag,3 baro,4 GPS,5 mesafe; B=1 off,2 stuck. Süre sonunda geri alınır. Olaylar çakışamaz.</string>
                  </property>
                  <property name="wordWrap">
                    <bool>true</bool>
                  </property>
                </widget>
              </item>
